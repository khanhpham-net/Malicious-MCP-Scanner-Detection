{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/khanhpham-net/Malicious-MCP-Scanner-Detection/schemas/scan-report-v1.0.json",
  "title": "MCP Security Scanner Report (Contract v1.0)",
  "description": "Canonical v1.0 JSON contract shared by Core Engine (Khanh), Collector/Benchmark Runner (Duy), and P-Detector/Scoring/Reporting/Review (Van).",
  "type": "object",
  "required": [
    "contract_version",
    "artifact_type",
    "generated_at",
    "scanner",
    "input_provenance",
    "scan_status",
    "policy_status",
    "exit_code",
    "coverage",
    "telemetry",
    "discovered_servers",
    "trust_score",
    "executive_summary",
    "findings",
    "review_queue",
    "diagnostics"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0"
    },
    "artifact_type": {
      "const": "scan_report"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "scanner": {
      "type": "object",
      "required": [
        "name",
        "version",
        "profile",
        "ruleset_sha256",
        "policy_version",
        "owasp_profile",
        "engines"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "profile": { "type": "string", "minLength": 1 },
        "ruleset_sha256": { "type": ["string", "null"] },
        "policy_version": { "type": "string", "minLength": 1 },
        "owasp_profile": { "type": "string", "minLength": 1 },
        "engines": {
          "type": "array",
          "items": { "type": "object" }
        }
      }
    },
    "input_provenance": {
      "type": "object",
      "required": [
        "server_id",
        "source_id",
        "input_kind",
        "location",
        "revision",
        "package_name",
        "package_version",
        "snapshot_sha256",
        "languages",
        "frameworks"
      ],
      "properties": {
        "server_id": { "type": "string", "minLength": 1 },
        "source_id": { "type": ["string", "null"] },
        "input_kind": {
          "type": "string",
          "enum": [
            "git_repo_snapshot",
            "package_artifact_only",
            "metadata_snapshot_only",
            "local_directory",
            "config_file"
          ]
        },
        "location": { "type": "string", "minLength": 1 },
        "revision": { "type": ["string", "null"] },
        "package_name": { "type": ["string", "null"] },
        "package_version": { "type": ["string", "null"] },
        "snapshot_sha256": { "type": "string", "minLength": 1 },
        "languages": {
          "type": "array",
          "items": { "type": "string" }
        },
        "frameworks": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "scan_status": {
      "type": "string",
      "enum": ["complete", "partial", "failed", "unsupported"]
    },
    "policy_status": {
      "type": "string",
      "enum": ["pass", "fail", "not_evaluated"]
    },
    "exit_code": {
      "type": "integer",
      "enum": [0, 1, 2],
      "description": "Precedence: scan_fail/partial/unsupported (2) > policy_fail (1) > complete+pass (0)."
    },
    "coverage": {
      "type": "object",
      "required": [
        "files_discovered",
        "files_scanned",
        "scanned_files",
        "skipped_files",
        "read_errors",
        "skipped_budget",
        "surfaces",
        "sca_status",
        "analysis_boundaries"
      ],
      "properties": {
        "files_discovered": { "type": "integer", "minimum": 0 },
        "files_scanned": { "type": "integer", "minimum": 0 },
        "scanned_files": {
          "type": "array",
          "items": { "type": "string" }
        },
        "skipped_files": {
          "type": "array",
          "items": { "$ref": "#/$defs/skipped_file" }
        },
        "read_errors": {
          "type": "array",
          "items": { "$ref": "#/$defs/read_error" }
        },
        "skipped_budget": {
          "type": "array",
          "items": { "$ref": "#/$defs/skipped_file" }
        },
        "surfaces": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "sca_status": {
          "type": "string",
          "enum": ["complete", "partial", "unmeasured", "unsupported", "failed"]
        },
        "analysis_boundaries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "location", "detail"],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "dynamic_dispatch",
                  "external_lib",
                  "budget_exceeded",
                  "runtime_only_unobserved",
                  "unobserved_lfs_or_submodule"
                ]
              },
              "location": { "type": ["string", "null"] },
              "detail": { "type": "string" }
            }
          }
        }
      }
    },
    "telemetry": {
      "type": "object",
      "required": [
        "elapsed_seconds",
        "stage_durations_seconds",
        "budget_cutoff_seconds",
        "hard_timeout_seconds",
        "timed_out",
        "llm_triage"
      ],
      "properties": {
        "elapsed_seconds": { "type": "number", "minimum": 0 },
        "stage_durations_seconds": {
          "type": "object",
          "additionalProperties": { "type": "number", "minimum": 0 }
        },
        "budget_cutoff_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "hard_timeout_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "timed_out": { "type": "boolean" },
        "llm_triage": {
          "type": "object",
          "required": [
            "enabled",
            "status",
            "model_id",
            "prompt_hash",
            "tokens_used",
            "estimated_cost_usd"
          ],
          "properties": {
            "enabled": { "type": "boolean" },
            "status": { "type": "string" },
            "model_id": { "type": ["string", "null"] },
            "prompt_hash": { "type": ["string", "null"] },
            "tokens_used": { "type": "integer", "minimum": 0 },
            "estimated_cost_usd": { "type": "number", "minimum": 0 }
          }
        }
      }
    },
    "discovered_servers": {
      "type": "array",
      "items": { "type": "object" }
    },
    "trust_score": {
      "type": "object",
      "required": [
        "score_scope",
        "observed_score",
        "displayed_score",
        "provisional_cap",
        "policy_version",
        "reason",
        "contributing_finding_ids"
      ],
      "properties": {
        "score_scope": {
          "type": "string",
          "enum": ["complete", "provisional", "unavailable"]
        },
        "observed_score": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 100
        },
        "displayed_score": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 100
        },
        "provisional_cap": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 100
        },
        "policy_version": { "type": "string", "minLength": 1 },
        "reason": { "type": "string" },
        "contributing_finding_ids": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "executive_summary": {
      "type": "object",
      "required": ["tldr", "severity_counts", "owasp_counts", "top_5"],
      "properties": {
        "tldr": { "type": "string" },
        "severity_counts": {
          "type": "object",
          "required": ["critical", "high", "medium", "low", "info"],
          "properties": {
            "critical": { "type": "integer", "minimum": 0 },
            "high": { "type": "integer", "minimum": 0 },
            "medium": { "type": "integer", "minimum": 0 },
            "low": { "type": "integer", "minimum": 0 },
            "info": { "type": "integer", "minimum": 0 }
          }
        },
        "owasp_counts": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "top_5": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": [
              "finding_id",
              "title",
              "severity",
              "owasp_id",
              "impact_summary",
              "location",
              "remediation"
            ],
            "properties": {
              "finding_id": { "type": "string" },
              "title": { "type": "string" },
              "severity": { "$ref": "#/$defs/severity" },
              "owasp_id": { "type": ["string", "null"] },
              "impact_summary": { "type": "string" },
              "location": { "type": "string" },
              "remediation": { "type": "string" }
            }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "review_queue": {
      "type": "object",
      "required": ["requires_review", "priority_tier", "reasons", "status"],
      "properties": {
        "requires_review": { "type": "boolean" },
        "priority_tier": {
          "type": "string",
          "enum": ["p0_high_or_malicious", "p1_partial_coverage", "p2_score_ranked", "none"]
        },
        "reasons": {
          "type": "array",
          "items": { "type": "string" }
        },
        "status": { "$ref": "#/$defs/review_status" }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": { "type": "object" }
    }
  },
  "$defs": {
    "severity": {
      "type": "string",
      "enum": ["critical", "high", "medium", "low", "info"]
    },
    "review_status": {
      "type": "string",
      "enum": [
        "not_required",
        "pending",
        "in_review_r1",
        "in_review_r2",
        "confirmed_threat",
        "benign_fp",
        "inconclusive"
      ]
    },
    "skipped_file": {
      "type": "object",
      "required": ["path", "reason"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "read_error": {
      "type": "object",
      "required": ["path", "error_code", "message"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "error_code": { "type": "string", "minLength": 1 },
        "message": { "type": "string" }
      }
    },
    "source_span": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "start_line": { "type": "integer", "minimum": 1 },
        "start_col": { "type": "integer", "minimum": 1 },
        "end_line": { "type": "integer", "minimum": 1 },
        "end_col": { "type": "integer", "minimum": 1 },
        "json_pointer": { "type": "string" }
      }
    },
    "trace_step": {
      "type": "object",
      "required": ["role", "span", "edge_kind"],
      "properties": {
        "role": {
          "type": "string",
          "enum": ["source", "call", "transform", "guard", "sink", "artifact"]
        },
        "span": { "$ref": "#/$defs/source_span" },
        "symbol": { "type": "string" },
        "edge_kind": { "type": "string", "enum": ["definite", "possible"] },
        "note": { "type": "string" }
      }
    },
    "owasp_mapping": {
      "type": "object",
      "required": [
        "status",
        "primary_id",
        "primary_name",
        "profile_version",
        "secondary_ids",
        "llm_top10_ids",
        "predicate_rationale"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["mapped", "pending_review", "not_applicable"]
        },
        "primary_id": { "type": ["string", "null"] },
        "primary_name": { "type": ["string", "null"] },
        "profile_version": { "type": "string", "minLength": 1 },
        "secondary_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "llm_top10_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "predicate_rationale": { "type": "string" }
      }
    },
    "finding": {
      "type": "object",
      "required": [
        "finding_id",
        "root_cause_group_id",
        "server_id",
        "component",
        "rule_id",
        "rule_version",
        "detector",
        "kind",
        "category",
        "severity",
        "evidence_strength",
        "confidence",
        "mcp_surface",
        "owasp_mapping",
        "cwe_ids",
        "title",
        "declaration_span",
        "sink_span",
        "trace",
        "redacted_evidence",
        "reasoning",
        "remediation",
        "limitations",
        "evidence_sources",
        "review_status"
      ],
      "properties": {
        "finding_id": { "type": "string", "minLength": 1 },
        "root_cause_group_id": { "type": "string", "minLength": 1 },
        "server_id": { "type": "string", "minLength": 1 },
        "component": { "type": "string", "minLength": 1 },
        "rule_id": { "type": "string", "minLength": 1 },
        "rule_version": { "type": "string", "minLength": 1 },
        "detector": { "type": "string", "minLength": 1 },
        "kind": {
          "type": "string",
          "enum": [
            "malicious_behavior",
            "vulnerability",
            "semantic_indicator",
            "capability_info",
            "dependency_advisory",
            "config_risk"
          ]
        },
        "category": {
          "type": "string",
          "enum": [
            "M",
            "C",
            "S",
            "P",
            "dynamic_code_execution",
            "supply_chain",
            "config_auth",
            "other"
          ]
        },
        "severity": { "$ref": "#/$defs/severity" },
        "evidence_strength": {
          "type": "string",
          "enum": ["verified", "traced_or_grounded", "heuristic_only"]
        },
        "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "mcp_surface": {
          "type": "string",
          "enum": ["A1", "A2", "A3", "A4", "A5", "A6", "A7", "A8", "A9", "A10", "A11", "A12", "unknown"]
        },
        "owasp_mapping": { "$ref": "#/$defs/owasp_mapping" },
        "cwe_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "title": { "type": "string", "minLength": 1 },
        "declaration_span": {
          "oneOf": [{ "$ref": "#/$defs/source_span" }, { "type": "null" }]
        },
        "sink_span": {
          "oneOf": [{ "$ref": "#/$defs/source_span" }, { "type": "null" }]
        },
        "trace": {
          "type": "array",
          "items": { "$ref": "#/$defs/trace_step" }
        },
        "redacted_evidence": {
          "oneOf": [
            {
              "type": "object",
              "required": ["snippet", "secrets_redacted"],
              "properties": {
                "snippet": { "type": "string" },
                "secrets_redacted": { "type": "boolean" }
              }
            },
            { "type": "null" }
          ]
        },
        "reasoning": { "type": "string" },
        "remediation": { "type": "string" },
        "limitations": {
          "type": "array",
          "items": { "type": "string" }
        },
        "evidence_sources": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "review_status": { "$ref": "#/$defs/review_status" }
      }
    }
  }
}
